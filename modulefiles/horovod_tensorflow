#%Module

module-whatis 'anaconda 3 - Horovod-Tensorflow Environment'

proc ModulesHelp { } {
    puts stderr "Conda environment with Horovod-Tensorflow"
}

setenv CONDA_SHLVL 1
setenv CONDA_PREFIX /home/apps/MLDL/DL-CondaPy3.10/envs/Horovod-Tensorflow
prepend-path PATH $env(CONDA_PREFIX)/bin
setenv CONDA_DEFAULT_ENV Horovod-Tensorflow
setenv VIRTUAL_ENV $env(CONDA_PREFIX)

if { [module-info mode load] } {
        system source $env(CONDA_PREFIX)/bin/activate Horovod-Tensorflow
        system conda activate Horovod-Tensorflow
}

if { [module-info mode remove] } {
        system conda deactivate
        system conda deactivate
        system /bin/bash
}
