#%Module

module-whatis 'anaconda 3 - PyTorch Environment'

proc ModulesHelp { } {
    puts stderr "Conda environment with PyTorch"
}

setenv CONDA_SHLVL 1
setenv CONDA_PREFIX /home/apps/MLDL/DL-CondaPy3.10/envs/Pytorch
prepend-path PATH $env(CONDA_PREFIX)/bin
setenv CONDA_DEFAULT_ENV Pytorch
setenv VIRTUAL_ENV $env(CONDA_PREFIX)

if { [module-info mode load] } {
        system source $env(CONDA_PREFIX)/bin/activate Pytorch
        system conda activate Pytorch
}

if { [module-info mode remove] } {
        system conda deactivate
        system conda deactivate
        system /bin/bash
}