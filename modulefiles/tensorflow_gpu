#%Module

module-whatis 'anaconda 3 - Tensorflow-gpu Environment'

proc ModulesHelp { } {
    puts stderr "Conda environment with Tensorflow-gpu"
}

setenv CONDA_SHLVL 1
setenv CONDA_PREFIX /home/apps/MLDL/DL-CondaPy3.10/envs/Tensorflow-gpu
prepend-path PATH $env(CONDA_PREFIX)/bin
setenv CONDA_DEFAULT_ENV Tensorflow-gpu
setenv VIRTUAL_ENV $env(CONDA_PREFIX)

if { [module-info mode load] } {
        system source $env(CONDA_PREFIX)/bin/activate Tensorflow-gpu
        system conda activate Tensorflow-gpu
}

if { [module-info mode remove] } {
        system conda deactivate
        system conda deactivate
        system /bin/bash
}

