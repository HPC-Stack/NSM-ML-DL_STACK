#%Module

module-whatis 'anaconda 3 - Caffe Environment'

proc ModulesHelp { } {
    puts stderr "Conda environment with Caffe"
}

setenv CONDA_SHLVL 1
setenv CONDA_PREFIX /home/apps/MLDL/DL-CondaPy3.10/envs/Caffe
prepend-path PATH $env(CONDA_PREFIX)/bin
setenv CONDA_DEFAULT_ENV Caffe
setenv VIRTUAL_ENV $env(CONDA_PREFIX)

if { [module-info mode load] } {
        system source $env(CONDA_PREFIX)/bin/activate Caffe
        system conda activate Caffe
}

if { [module-info mode remove] } {
        system conda deactivate
        system conda deactivate
        system /bin/bash
}

